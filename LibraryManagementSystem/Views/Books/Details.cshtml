@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-9">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <!-- Header -->

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h1 class="mb-2">
                                @Model.Title
                            </h1>

                            <p class="text-muted mb-0">
                                Book Details
                            </p>

                        </div>

                        <a asp-controller="LibraryBooks"
                           asp-action="Index"
                           class="btn btn-secondary">
                            ← Back to Books
                        </a>

                    </div>

                    <hr />


                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }


                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }


                    <div class="row">

                        <!-- Book Information -->

                        <div class="col-md-6">

                            <h4 class="mb-3">
                                Book Information
                            </h4>

                            <dl class="row">

                                <dt class="col-sm-5">
                                    Title
                                </dt>

                                <dd class="col-sm-7">
                                    @Model.Title
                                </dd>


                                <dt class="col-sm-5">
                                    Author
                                </dt>

                                <dd class="col-sm-7">
                                    @Model.Author
                                </dd>


                                <dt class="col-sm-5">
                                    ISBN
                                </dt>

                                <dd class="col-sm-7">
                                    @(Model.ISBN ?? "-")
                                </dd>


                                <dt class="col-sm-5">
                                    Publisher
                                </dt>

                                <dd class="col-sm-7">
                                    @(Model.Publisher ?? "-")
                                </dd>


                                <dt class="col-sm-5">
                                    Publication Year
                                </dt>

                                <dd class="col-sm-7">
                                    @Model.PublicationYear
                                </dd>


                                <dt class="col-sm-5">
                                    Category
                                </dt>

                                <dd class="col-sm-7">
                                    @(Model.Category?.Name ?? "-")
                                </dd>

                            </dl>

                        </div>


                        <!-- Availability -->

                        <div class="col-md-6">

                            <h4 class="mb-3">
                                Availability
                            </h4>

                            <div class="card bg-light p-3">

                                <div class="mb-3">

                                    <strong>
                                        Total Copies:
                                    </strong>

                                    <span>
                                        @Model.TotalCopies
                                    </span>

                                </div>


                                <div>

                                    <strong>
                                        Available Copies:
                                    </strong>

                                    @if (Model.AvailableCopies > 0)
                                    {
                                        <span class="badge bg-success ms-2">
                                            @Model.AvailableCopies Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger ms-2">
                                            Not Available
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- Reservation -->
                            @if (Model.AvailableCopies == 0)
                            {
                                <div class="mt-4">

                                    @if (User.Identity?.IsAuthenticated == true &&
                                         (User.IsInRole("Student") ||
                                          User.IsInRole("Faculty")))
                                    {
                                        <form asp-controller="LibraryBooks"
                                              asp-action="Reserve"
                                              asp-route-id="@Model.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-warning w-100">
                                                📌 Reserve This Book
                                            </button>

                                        </form>

                                        <small class="text-muted d-block mt-2">
                                            You can reserve this book because
                                            it is currently unavailable.
                                        </small>
                                    }
                                    else
                                    {
                                        <a asp-area="Identity"
                                           asp-page="/Account/Login"
                                           class="btn btn-warning w-100">
                                            🔐 Login to Reserve
                                        </a>

                                        <small class="text-muted d-block mt-2">
                                            Please login as a Student or Faculty
                                            member to reserve this book.
                                        </small>
                                    }

                                </div>
                            }

                        </div>

                    </div>


                    <hr />


                    <!-- Description -->

                    <h4 class="mb-3">
                        Description
                    </h4>

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted">
                            No description available.
                        </p>
                    }
                    else
                    {
                        <p>
                            @Model.Description
                        </p>
                    }


                    <hr />


                    <!-- Bottom Buttons -->

                    <div class="d-flex gap-2">

                        <a asp-controller="LibraryBooks"
                           asp-action="Index"
                           class="btn btn-secondary">
                            ← Back to Books
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            🏠 Back to Home
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
