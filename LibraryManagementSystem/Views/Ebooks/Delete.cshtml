@model LibraryManagementSystem.Models.EBook

@{
    ViewData["Title"] = "Delete E-Book";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <!-- Icon -->

                    <div style="
                        width:80px;
                        height:80px;
                        margin:0 auto 20px;
                        border-radius:50%;
                        background:#fff3f3;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        font-size:40px;
                        border:1px solid #f1caca;">
                        ⚠️
                    </div>


                    <!-- Title -->

                    <h1 class="mb-3">
                        Delete E-Book
                    </h1>

                    <p class="text-muted mb-4">
                        Are you sure you want to delete this e-book?
                    </p>


                    <!-- E-Book Information -->

                    <div class="p-4 mb-4"
                         style="
                        background:#f4f9f6;
                        border:1px solid #d7e8df;
                        border-radius:12px;
                        text-align:left;">

                        <div class="mb-3">

                            <strong>
                                E-Book Title
                            </strong>

                            <div class="mt-1"
                                 style="
                                font-size:20px;
                                font-weight:600;
                                color:#007a43;">

                                @Model.Title

                            </div>

                        </div>


                        <div class="mb-3">

                            <strong>
                                Author
                            </strong>

                            <div class="text-muted mt-1">

                                @Model.Author

                            </div>

                        </div>


                        <div class="mb-3">

                            <strong>
                                Category
                            </strong>

                            <div class="text-muted mt-1">

                                @(string.IsNullOrWhiteSpace(Model.Category)
                                    ? "N/A"
                                    : Model.Category)

                            </div>

                        </div>


                        <div>

                            <strong>
                                PDF File
                            </strong>

                            <div class="text-muted mt-1">

                                @Model.FileName

                            </div>

                        </div>

                    </div>


                    <!-- Delete Form -->

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />


                        <div class="d-flex justify-content-center gap-3">

                            <button type="submit"
                                    class="btn btn-danger px-4 py-2">

                                🗑️ Delete E-Book

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary px-4 py-2">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
