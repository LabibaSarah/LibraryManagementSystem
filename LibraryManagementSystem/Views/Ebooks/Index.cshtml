@model IEnumerable<LibraryManagementSystem.Models.EBook>

@{
    ViewData["Title"] = "Manage E-Books";
}

<div class="container py-5">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Manage E-Books</h1>

            <p class="lead mb-0">
                Upload and manage digital books for the library.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Admin"
               asp-action="Index"
               class="btn btn-secondary">
                ← Dashboard
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                + Add E-Book
            </a>

        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- E-Book List -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h3 class="mb-0">
                    E-Book Collection
                </h3>

                <span class="badge bg-primary">
                    @Model.Count() E-Books
                </span>

            </div>

            <hr />


            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Category</th>
                                <th>Uploaded</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int serial = 1;
                            }

                            @foreach (var ebook in Model)
                            {
                                <tr>

                                    <td>
                                        @serial
                                    </td>

                                    <td>
                                        <strong>
                                            @ebook.Title
                                        </strong>
                                    </td>

                                    <td>
                                        @ebook.Author
                                    </td>

                                    <td>
                                        @(ebook.Category ?? "-")
                                    </td>

                                    <td>
                                        @ebook.UploadedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <!-- View PDF -->

                                            <a href="@ebook.FilePath"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-success">
                                                View
                                            </a>


                                            <!-- Delete -->

                                            <a asp-action="Delete"
                                               asp-route-id="@ebook.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                serial++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div style="font-size: 50px;">
                        📚
                    </div>

                    <h4 class="mt-3">
                        No E-Books Available
                    </h4>

                    <p class="text-muted">
                        Start by uploading your first digital book.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Add First E-Book
                    </a>

                </div>
            }

        </div>

    </div>

</div>
