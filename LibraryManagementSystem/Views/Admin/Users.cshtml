@model IEnumerable<LibraryManagementSystem.Data.ApplicationUser>

@{
    ViewData["Title"] = "User Management";

    var userRoles =
        ViewBag.UserRoles as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    string? search = ViewBag.Search;
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>User Management</h1>

            <p class="lead mb-0">
                Manage registered students and faculty members.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>


    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- Search -->

    <div class="card shadow-sm p-4 mb-4">

        <form asp-action="Users"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-9">

                    <label class="form-label">
                        Search Users
                    </label>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Search by name, University ID or email..." />

                </div>

                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- Users Table -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <h3>
                    Registered Users
                </h3>

                <span class="badge bg-primary">
                    @Model.Count() Users
                </span>

            </div>

            <hr />

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Full Name</th>
                            <th>University ID</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                var role =
                                    userRoles.ContainsKey(user.Id)
                                    ? userRoles[user.Id]
                                    : "No Role";

                                <tr>

                                    <td>
                                        <strong>
                                            @user.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @user.UniversityId
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>

                                        @if (role == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                Admin
                                            </span>
                                        }
                                        else if (role == "Faculty")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Faculty
                                            </span>
                                        }
                                        else if (role == "Student")
                                        {
                                            <span class="badge bg-success">
                                                Student
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @role
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (role != "Admin")
                                        {
                                            <form asp-action="DeleteUser"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this user?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    Delete
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Protected
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center py-4">

                                    <strong>
                                        No users found.
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>