@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-9">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="mb-2">
                        @Model.Title
                    </h1>

                    <p class="text-muted">
                        Book Details
                    </p>

                    <hr />


                    <!-- Success / Error Messages -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }


                    <div class="row">

                        <!-- Basic Information -->

                        <div class="col-md-6">

                            <h4 class="mb-3">
                                Book Information
                            </h4>

                            <p>
                                <strong>Title:</strong>
                                @Model.Title
                            </p>

                            <p>
                                <strong>Author:</strong>
                                @Model.Author
                            </p>

                            <p>
                                <strong>ISBN:</strong>
                                @(Model.ISBN ?? "-")
                            </p>

                            <p>
                                <strong>Publisher:</strong>
                                @(Model.Publisher ?? "-")
                            </p>

                            <p>
                                <strong>Publication Year:</strong>
                                @Model.PublicationYear
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @(Model.Category?.Name ?? "-")
                            </p>

                        </div>


                        <!-- Availability -->

                        <div class="col-md-6">

                            <h4 class="mb-3">
                                Availability
                            </h4>

                            <div class="card bg-light p-3">

                                <p class="mb-2">
                                    <strong>Total Copies:</strong>
                                    @Model.TotalCopies
                                </p>

                                <p class="mb-0">
                                    <strong>Available Copies:</strong>

                                    @if (Model.AvailableCopies > 0)
                                    {
                                        <span class="badge bg-success">
                                            @Model.AvailableCopies Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Not Available
                                        </span>
                                    }

                                </p>

                            </div>

                        </div>

                    </div>


                    <hr />


                    <!-- Description -->

                    <h4>Description</h4>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description available."
                            : Model.Description)
                    </p>


                    <hr />


                    <!-- Book Action -->

                    <div class="d-flex gap-2">

                        @if (Model.AvailableCopies > 0)
                        {
                            <a asp-controller="Transactions"
                               asp-action="Create"
                               asp-route-bookId="@Model.Id"
                               class="btn btn-success">
                                Borrow Book
                            </a>
                        }
                        else
                        {
                            <form asp-controller="LibraryBooks"
                                  asp-action="Reserve"
                                  asp-route-id="@Model.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-warning">
                                    Reserve Book
                                </button>

                            </form>
                        }

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to Books
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>