@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Browse Books";

    var categories =
        ViewBag.Categories as IEnumerable<LibraryManagementSystem.Models.Category>
        ?? Enumerable.Empty<LibraryManagementSystem.Models.Category>();

    string? search = ViewBag.Search;
    int? selectedCategory = ViewBag.CategoryId;
}

<div class="container py-5">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Browse Books</h1>

            <p class="lead mb-0">
                Search and explore books available in the library.
            </p>
        </div>

        <!-- Back to Home -->

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            ← Back to Home
        </a>

    </div>


    <!-- Search & Filter -->

    <div class="card shadow-sm p-4 mb-4">

        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- Search -->

                <div class="col-md-6">

                    <label class="form-label">
                        Search Books
                    </label>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Search by title, author, ISBN or keyword..." />

                </div>


                <!-- Category -->

                <div class="col-md-4">

                    <label class="form-label">
                        Category
                    </label>

                    <select name="categoryId"
                            class="form-select">

                        <option value="">
                            -- All Categories --
                        </option>

                        @foreach (var category in categories)
                        {
                            if (selectedCategory == category.Id)
                            {
                                <option value="@category.Id"
                                        selected>
                                    @category.Name
                                </option>
                            }
                            else
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Search Button -->

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- Results -->

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between mb-3">

                <h3 class="mb-0">
                    Available Books
                </h3>

                <span class="badge bg-primary align-self-center">
                    @Model.Count() Books
                </span>

            </div>

            <hr />


            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>ISBN</th>
                                <th>Category</th>
                                <th>Available</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var book in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @book.Title
                                        </strong>
                                    </td>

                                    <td>
                                        @book.Author
                                    </td>

                                    <td>
                                        @(book.ISBN ?? "-")
                                    </td>

                                    <td>
                                        @(book.Category?.Name ?? "-")
                                    </td>

                                    <td>

                                        @if (book.AvailableCopies > 0)
                                        {
                                            <span class="badge bg-success">
                                                @book.AvailableCopies Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Not Available
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@book.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            View Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>No books found</h5>

                    <p class="text-muted">
                        Try another search keyword or category.
                    </p>

                </div>
            }

        </div>

    </div>

</div>
