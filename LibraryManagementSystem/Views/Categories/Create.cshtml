@model LibraryManagementSystem.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="category-form-page">

    <!-- ================= HEADER ================= -->

    <div class="category-form-header">

        <div>

            <h1>
                Add New Category
            </h1>

            <p>
                Create a category for organizing library books.
            </p>

        </div>

        <div class="category-header-icon">
            🗂️
        </div>

    </div>


    <!-- ================= FORM CARD ================= -->

    <div class="category-form-card">

        <div class="category-form-title">

            <div class="category-form-title-icon">
                📚
            </div>

            <div>

                <h2>
                    Category Information
                </h2>

                <p>
                    Enter the category name and description.
                </p>

            </div>

        </div>


        <hr />


        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <!-- Category Name -->

            <div class="mb-4">

                <label asp-for="Name"
                       class="form-label">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="form-control category-input"
                       placeholder="e.g. Computer Science" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <!-- Description -->

            <div class="mb-4">

                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control category-textarea"
                          rows="5"
                          placeholder="Enter a short description about this category"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>


            <!-- Buttons -->

            <div class="category-form-actions">

                <a asp-action="Index"
                   class="category-back-btn">
                    ← Back to Categories
                </a>

                <button type="submit"
                        class="category-save-btn">
                    ✓ Add Category
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}