@{
    ViewData["Title"] = "Research Support";
}

<div class="library-page">

    <!-- ================= HEADER ================= -->

    <div class="library-page-header">

        <h1>
            Research Support
        </h1>

        <p>
            Explore academic databases and research resources for your studies.
        </p>

    </div>


    <!-- ================= RESEARCH RESOURCES ================= -->

    <div class="research-resource-grid">


        <!-- Google Scholar -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                🎓
            </div>

            <h3>
                Google Scholar
            </h3>

            <p>
                Search scholarly articles, theses, books, conference papers
                and academic publications from different fields.
            </p>

            <a href="https://scholar.google.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit Google Scholar →
            </a>

        </div>


        <!-- IEEE Xplore -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                ⚡
            </div>

            <h3>
                IEEE Xplore
            </h3>

            <p>
                Find research papers, journals, conference proceedings and
                technical publications in computer science and engineering.
            </p>

            <a href="https://ieeexplore.ieee.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit IEEE Xplore →
            </a>

        </div>


        <!-- ResearchGate -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                🔬
            </div>

            <h3>
                ResearchGate
            </h3>

            <p>
                Discover research papers, connect with researchers and
                explore academic publications and research discussions.
            </p>

            <a href="https://www.researchgate.net/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit ResearchGate →
            </a>

        </div>


        <!-- ScienceDirect -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                📚
            </div>

            <h3>
                ScienceDirect
            </h3>

            <p>
                Explore peer-reviewed research articles, journals and
                scientific publications across many academic disciplines.
            </p>

            <a href="https://www.sciencedirect.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit ScienceDirect →
            </a>

        </div>


        <!-- SpringerLink -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                📖
            </div>

            <h3>
                SpringerLink
            </h3>

            <p>
                Access academic journals, books, conference papers and
                research publications from Springer.
            </p>

            <a href="https://link.springer.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit SpringerLink →
            </a>

        </div>


        <!-- ACM Digital Library -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                💻
            </div>

            <h3>
                ACM Digital Library
            </h3>

            <p>
                Find computer science research papers, journals,
                conference proceedings and technical publications.
            </p>

            <a href="https://dl.acm.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit ACM Library →
            </a>

        </div>


        <!-- PubMed -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                🧬
            </div>

            <h3>
                PubMed
            </h3>

            <p>
                Search biomedical, healthcare, life science and medical
                research literature.
            </p>

            <a href="https://pubmed.ncbi.nlm.nih.gov/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit PubMed →
            </a>

        </div>


        <!-- Semantic Scholar -->

        <div class="research-resource-card">

            <div class="research-resource-icon">
                🧠
            </div>

            <h3>
                Semantic Scholar
            </h3>

            <p>
                Discover scientific literature using AI-powered search
                and explore related academic research.
            </p>

            <a href="https://www.semanticscholar.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">
                Visit Semantic Scholar →
            </a>

        </div>

    </div>


    <!-- ================= BACK ================= -->

    <div class="library-back">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">

            ← Back to Home

        </a>

    </div>

</div>


<!-- ================= PAGE CSS ================= -->

<style>

    .research-resource-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        max-width: 1200px;
        margin: 45px auto;
    }


    .research-resource-card {
        background: #ffffff;
        border: 1px solid #d5e7dc;
        border-radius: 16px;
        padding: 35px 28px;
        text-align: center;
        min-height: 360px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }


        .research-resource-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 100, 50, 0.12);
            border-color: #198754;
        }


    .research-resource-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #eaf7ef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin-bottom: 18px;
    }


    .research-resource-card h3 {
        color: #007a3d;
        font-size: 25px;
        font-weight: 600;
        margin-bottom: 15px;
    }


    .research-resource-card p {
        color: #667085;
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 25px;
        flex-grow: 1;
    }


    .research-resource-card .btn {
        background-color: #198754;
        border-color: #198754;
        padding: 10px 18px;
        border-radius: 7px;
        font-weight: 500;
    }


        .research-resource-card .btn:hover {
            background-color: #146c43;
            border-color: #146c43;
        }


    .library-back {
        max-width: 1200px;
        margin: 20px auto 40px;
    }


    /* IMPORTANT: Razor requires @@media */

    @@media (max-width: 992px) {

        .research-resource-grid {
            grid-template-columns: repeat(2, 1fr);
            padding: 0 20px;
        }
    }


    @@media (max-width: 576px) {

        .research-resource-grid {
            grid-template-columns: 1fr;
        }
    }

</style>