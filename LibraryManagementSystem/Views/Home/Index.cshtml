@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "IUBAT Central Library";

    var categories =
        ViewBag.Categories as IEnumerable<Category>
        ?? Enumerable.Empty<Category>();
}

<!-- =========================
     TOP BAR
========================= -->

<div class="library-topbar">

    <div class="topbar-left">

        <span>✉ library@iubat.edu</span>

        <span class="top-divider">|</span>

        <span>☎ +880 1717 123456</span>

    </div>


    <div class="topbar-right">

        <span class="status-dot"></span>

        <span>
            Library Status:
            <strong>OPEN</strong>
        </span>

        <span class="top-divider">|</span>

        <span>8:00 AM - 8:30 PM</span>

        <span class="top-divider">|</span>

        <a asp-controller="Home"
           asp-action="Services">
            Help
        </a>

        <span class="top-divider">|</span>

        <a asp-controller="Home"
           asp-action="Services">
            FAQ
        </a>

        <span class="top-divider">|</span>

        <a asp-controller="Home"
           asp-action="About">
            Contact Us
        </a>

    </div>

</div>


<!-- =========================
     MAIN NAVBAR
========================= -->

<nav class="library-navbar">

    <div class="library-brand">

        <div class="library-logo">

            <img src="~/images/iubat-logo.png"
                 alt="IUBAT Logo" />

        </div>


        <div>

            <div class="library-name">
                IUBAT Central Library
            </div>

            <div class="library-tagline">
                Knowledge for Innovation and Excellence
            </div>

        </div>

    </div>


    <div class="library-nav-links">

        <!-- Home -->

        <a asp-controller="Home"
           asp-action="Index"
           class="active">
            Home
        </a>


        <!-- Books -->

        <a asp-controller="LibraryBooks"
           asp-action="Index">
            Books
        </a>


        <!-- E-Resources -->

        <a asp-controller="Home"
           asp-action="EResources">
            E-Resources
        </a>


        <!-- Thesis -->

        <a asp-controller="Home"
           asp-action="Thesis">
            Thesis & Reports
        </a>


        <!-- Research -->

        <a asp-controller="Home"
           asp-action="Research">
            Research Support
        </a>


        <!-- Services -->

        <a asp-controller="Home"
           asp-action="Services">
            Services
        </a>


        <!-- About -->

        <a asp-controller="Home"
           asp-action="About">
            About Us
        </a>


        <!-- =====================================================
             LOGIN / DASHBOARD
        ====================================================== -->
        @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
        {
            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Student"
                   asp-action="Index"
                   class="login-button">
                    🏠 Dashboard
                </a>
            }
            else if (User.IsInRole("Faculty"))
            {
                <a asp-controller="Faculty"
                   asp-action="Index"
                   class="login-button">
                    🏠 Dashboard
                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="login-button">
                    🏠 Dashboard
                </a>
            }


            <!-- Logout -->

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  method="post"
                  class="logout-form">

                <button type="submit"
                        class="logout-button">
                    🚪 Logout
                </button>

            </form>
        }
        else
        {
            <!-- Login -->

            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="login-button">
                👤 Login
            </a>
        }

    </div>

</nav>


<!-- =========================
     HERO SECTION
========================= -->

<section class="library-hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <h1>
            Discover. Learn. Grow.
        </h1>

        <h2>
            Welcome to IUBAT Central Library
        </h2>

        <p>
            Your gateway to a world of knowledge, research and innovation.
            <br />
            Find the resources you need to succeed.
        </p>


        <!-- SEARCH BOX -->

        <div class="hero-search">

            <div class="search-tabs">

                <button type="button"
                        class="search-tab active">
                    📖 Search Books
                </button>

                <button type="button"
                        class="search-tab">
                    📄 Search Articles
                </button>

                <button type="button"
                        class="search-tab">
                    📱 Search E-Books
                </button>

                <span class="search-tab advanced-search-text">
                    🔎 Advanced Search
                </span>

            </div>


            <form asp-controller="LibraryBooks"
                  asp-action="Index"
                  method="get"
                  class="search-form">

                <input type="text"
                       name="search"
                       placeholder="Search by title, author, ISBN or keyword..."
                       class="hero-search-input" />


                <select name="categoryId"
                        class="hero-category">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>


                <button type="submit"
                        class="hero-search-button">

                    🔍 Search

                </button>

            </form>

        </div>

    </div>

</section>


