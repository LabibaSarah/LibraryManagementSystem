@{
    ViewData["Title"] = "Thesis & Reports";
}

<div class="thesis-page">

    <!-- ================= HEADER ================= -->

    <div class="thesis-header">

        <div class="thesis-header-icon">
            🎓
        </div>

        <h1>
            Thesis & Reports
        </h1>

        <p>
            Explore academic theses, project reports and research resources.
        </p>

        <div class="thesis-header-line"></div>

    </div>


    <!-- ================= RESOURCE GRID ================= -->

    <div class="thesis-grid">


        <!-- Undergraduate Thesis -->

        <div class="thesis-card">

            <div class="thesis-card-icon">
                🎓
            </div>

            <h3>
                Undergraduate Thesis
            </h3>

            <p>
                Explore previous undergraduate thesis and academic
                research work from different departments.
            </p>

            <a href="https://scholar.google.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="thesis-btn">

                Explore Thesis ↗

            </a>

        </div>


        <!-- Project Reports -->

        <div class="thesis-card">

            <div class="thesis-card-icon">
                💻
            </div>

            <h3>
                Project Reports
            </h3>

            <p>
                Find academic project reports, final-year projects
                and software project documentation.
            </p>

            <a href="https://www.google.com/search?q=academic+project+reports"
               target="_blank"
               rel="noopener noreferrer"
               class="thesis-btn">

                Browse Reports ↗

            </a>

        </div>


        <!-- Research Reports -->

        <div class="thesis-card">

            <div class="thesis-card-icon">
                📊
            </div>

            <h3>
                Research Reports
            </h3>

            <p>
                Explore research reports, academic studies and
                research publications from different fields.
            </p>

            <a href="https://www.researchgate.net/"
               target="_blank"
               rel="noopener noreferrer"
               class="thesis-btn">

                Explore Research ↗

            </a>

        </div>


        <!-- Thesis Archive -->

        <div class="thesis-card">

            <div class="thesis-card-icon">
                🗂️
            </div>

            <h3>
                Thesis Archive
            </h3>

            <p>
                Browse and discover previously published theses
                by subject, department and academic field.
            </p>

            <a href="https://www.google.com/search?q=university+thesis+repository"
               target="_blank"
               rel="noopener noreferrer"
               class="thesis-btn">

                Browse Archive ↗

            </a>

        </div>


        <!-- Thesis Guidelines -->

        <div class="thesis-card">

            <div class="thesis-card-icon">
                📝
            </div>

            <h3>
                Thesis Guidelines
            </h3>

            <p>
                Learn about thesis structure, formatting, citation
                and academic research requirements.
            </p>

            <a href="https://owl.purdue.edu/owl/research_and_citation/index.html"
               target="_blank"
               rel="noopener noreferrer"
               class="thesis-btn">

                View Guidelines ↗

            </a>

        </div>


        <!-- Research Resources -->

        <div class="thesis-card">

            <div class="thesis-card-icon">
                📚
            </div>

            <h3>
                Research Resources
            </h3>

            <p>
                Access useful academic resources for literature
                review, research methodology and citations.
            </p>

            <a href="https://scholar.google.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="thesis-btn">

                Explore Resources ↗

            </a>

        </div>

    </div>


    <!-- ================= BACK ================= -->

    <div class="thesis-back">

        <a asp-controller="Home"
           asp-action="Index"
           class="thesis-back-btn">

            ← Back to Home

        </a>

    </div>

</div>
