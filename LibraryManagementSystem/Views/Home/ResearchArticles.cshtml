@{
    ViewData["Title"] = "Research Articles";
}

<div class="research-page">

    <!-- ================= HEADER ================= -->

    <div class="research-header">

        <div class="research-header-icon">
            📄
        </div>

        <h1>
            Research Articles
        </h1>

        <p>
            Discover academic articles and research publications from trusted
            databases and publishers.
        </p>

        <div class="research-header-line"></div>

    </div>


    <!-- ================= INFORMATION ================= -->

    <div class="research-info">

        <div class="research-info-icon">
            ℹ
        </div>

        <div>
            <strong>Access Top Research Platforms:</strong>
            Explore millions of research articles from trusted academic
            sources around the world.
        </div>

    </div>


    <!-- ================= RESEARCH WEBSITES ================= -->

    <div class="research-grid">


        <!-- Google Scholar -->

        <div class="research-card">

            <div class="research-logo google-scholar-logo">
                <span>G</span>
            </div>

            <h3>
                Google Scholar
            </h3>

            <p>
                Search scholarly articles, theses, books and conference
                papers across many disciplines.
            </p>

            <a href="https://scholar.google.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- ResearchGate -->

        <div class="research-card">

            <div class="research-logo researchgate-logo">
                R<sup>G</sup>
            </div>

            <h3>
                ResearchGate
            </h3>

            <p>
                Discover research, connect with researchers, and share
                your academic work.
            </p>

            <a href="https://www.researchgate.net/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- ScienceDirect -->

        <div class="research-card">

            <div class="research-logo sciencedirect-logo">
                📚
            </div>

            <h3>
                ScienceDirect
            </h3>

            <p>
                Access scientific, technical, and medical research
                publications.
            </p>

            <a href="https://www.sciencedirect.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- SpringerLink -->

        <div class="research-card">

            <div class="research-logo springer-logo">
                ♞
            </div>

            <h3>
                SpringerLink
            </h3>

            <p>
                Explore journals, books, and conference proceedings
                from Springer.
            </p>

            <a href="https://link.springer.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- IEEE Xplore -->

        <div class="research-card">

            <div class="research-logo ieee-logo">
                ◈ IEEE
            </div>

            <h3>
                IEEE Xplore
            </h3>

            <p>
                Access cutting-edge research in engineering,
                technology and computer science.
            </p>

            <a href="https://ieeexplore.ieee.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- PubMed -->

        <div class="research-card">

            <div class="research-logo pubmed-logo">
                PubMed
            </div>

            <h3>
                PubMed
            </h3>

            <p>
                Search biomedical literature, medical research and
                life sciences publications.
            </p>

            <a href="https://pubmed.ncbi.nlm.nih.gov/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- DOAJ -->

        <div class="research-card">

            <div class="research-logo doaj-logo">
                DOAJ
            </div>

            <h3>
                DOAJ
            </h3>

            <p>
                Discover open-access journals and peer-reviewed
                research articles.
            </p>

            <a href="https://doaj.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- arXiv -->

        <div class="research-card">

            <div class="research-logo arxiv-logo">
                arXiv
            </div>

            <h3>
                arXiv
            </h3>

            <p>
                Access open-access research papers in physics,
                mathematics, computer science and more.
            </p>

            <a href="https://arxiv.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>

    </div>


    <!-- ================= BACK ================= -->

    <div class="research-back">

        <a asp-controller="Home"
           asp-action="EResources"
           class="research-back-btn">

            ← Back to E-Resources

        </a>

    </div>

</div>
