@{
    ViewData["Title"] = "Library Services";
}

<div class="library-page">

    <!-- ================= HEADER ================= -->

    <div class="library-page-header">

        <h1>
            Library Services
        </h1>

        <p>
            Explore the services available to support your learning and academic activities.
        </p>

    </div>


    <!-- ================= SERVICES ================= -->

    <div class="services-grid">


        <!-- Book Borrowing -->

        <div class="service-card">

            <div class="service-icon">
                📚
            </div>

            <h3>
                Book Borrowing
            </h3>

            <p>
                Borrow books from the library collection for your academic and learning needs.
            </p>

        </div>


        <!-- E-Books -->

        <div class="service-card">

            <div class="service-icon">
                💻
            </div>

            <h3>
                E-Book Access
            </h3>

            <p>
                Access digital books and academic reading materials through the library's e-resources.
            </p>

        </div>


        <!-- Research Support -->

        <div class="service-card">

            <div class="service-icon">
                🔍
            </div>

            <h3>
                Research Support
            </h3>

            <p>
                Get support for finding research papers, academic databases and scholarly resources.
            </p>

        </div>


        <!-- Online Journals -->

        <div class="service-card">

            <div class="service-icon">
                📰
            </div>

            <h3>
                Online Journals
            </h3>

            <p>
                Explore scholarly journals and academic publications from different subject areas.
            </p>

        </div>


        <!-- Thesis & Reports -->

        <div class="service-card">

            <div class="service-icon">
                🎓
            </div>

            <h3>
                Thesis & Reports
            </h3>

            <p>
                Explore academic theses, project reports and research documents available through the library.
            </p>

        </div>


        <!-- Ask Librarian -->

        <div class="service-card">

            <div class="service-icon">
                👩‍🏫
            </div>

            <h3>
                Ask a Librarian
            </h3>

            <p>
                Contact library staff for assistance with books, research resources and library services.
            </p>

        </div>

    </div>


    <!-- ================= BACK ================= -->

    <div class="library-back">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">

            ← Back to Home

        </a>

    </div>

</div>


<!-- ================= PAGE STYLE ================= -->

<style>

    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        max-width: 1200px;
        margin: 45px auto;
    }


    .service-card {
        background: #ffffff;
        border: 1px solid #d5e7dc;
        border-radius: 16px;
        padding: 35px 28px;
        text-align: center;
        min-height: 320px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }


        .service-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 100, 50, 0.12);
            border-color: #198754;
        }


    .service-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #eaf7ef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        margin-bottom: 20px;
    }


    .service-card h3 {
        color: #007a3d;
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 15px;
    }


    .service-card p {
        color: #667085;
        font-size: 16px;
        line-height: 1.6;
        margin: 0;
    }


    .library-back {
        max-width: 1200px;
        margin: 20px auto 40px;
    }


    @@media (max-width: 992px) {

        .services-grid {
            grid-template-columns: repeat(2, 1fr);
            padding: 0 20px;
        }
    }


    @@media (max-width: 576px) {

        .services-grid {
            grid-template-columns: 1fr;
        }
    }

</style>