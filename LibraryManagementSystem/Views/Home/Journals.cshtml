@{
    ViewData["Title"] = "Online Journals";
}

<div class="research-page">

    <!-- ================= HEADER ================= -->

    <div class="research-header">

        <div class="research-header-icon">
            📰
        </div>

        <h1>
            Online Journals
        </h1>

        <p>
            Explore scholarly journals and academic publications from trusted sources.
        </p>

        <div class="research-header-line"></div>

    </div>


    <!-- ================= INFORMATION ================= -->

    <div class="research-info">

        <div class="research-info-icon">
            ℹ
        </div>

        <div>
            <strong>Explore Academic Journals:</strong>
            Access scholarly journals and academic publications from different
            disciplines and research fields.
        </div>

    </div>


    <!-- ================= JOURNAL WEBSITES ================= -->

    <div class="research-grid">


        <!-- ScienceDirect -->

        <div class="research-card">

            <div class="research-logo sciencedirect-logo">
                📚
            </div>

            <h3>
                ScienceDirect
            </h3>

            <p>
                Explore peer-reviewed journals and research articles in
                science, technology, medicine and more.
            </p>

            <a href="https://www.sciencedirect.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- Springer Nature -->

        <div class="research-card">

            <div class="research-logo springer-logo">
                ♞
            </div>

            <h3>
                Springer Nature
            </h3>

            <p>
                Browse academic journals, research articles and scholarly
                publications across many disciplines.
            </p>

            <a href="https://link.springer.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- Wiley Online Library -->

        <div class="research-card">

            <div class="research-logo wiley-logo">
                WILEY
            </div>

            <h3>
                Wiley Online Library
            </h3>

            <p>
                Access scholarly journals, books and research publications
                from different academic fields.
            </p>

            <a href="https://onlinelibrary.wiley.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- Taylor & Francis -->

        <div class="research-card">

            <div class="research-logo taylor-logo">
                T&F
            </div>

            <h3>
                Taylor & Francis
            </h3>

            <p>
                Discover academic journals and research publications in
                humanities, science and social sciences.
            </p>

            <a href="https://www.tandfonline.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- SAGE Journals -->

        <div class="research-card">

            <div class="research-logo sage-logo">
                SAGE
            </div>

            <h3>
                SAGE Journals
            </h3>

            <p>
                Explore peer-reviewed journals covering social science,
                business, education and many other subjects.
            </p>

            <a href="https://journals.sagepub.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- Oxford Academic -->

        <div class="research-card">

            <div class="research-logo oxford-logo">
                OXFORD
            </div>

            <h3>
                Oxford Academic
            </h3>

            <p>
                Browse scholarly journals and academic research published
                by Oxford University Press.
            </p>

            <a href="https://academic.oup.com/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- Cambridge Core -->

        <div class="research-card">

            <div class="research-logo cambridge-logo">
                C
            </div>

            <h3>
                Cambridge Core
            </h3>

            <p>
                Access academic journals, books and research publications
                from Cambridge University Press.
            </p>

            <a href="https://www.cambridge.org/core/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>


        <!-- JSTOR -->

        <div class="research-card">

            <div class="research-logo jstor-logo">
                JSTOR
            </div>

            <h3>
                JSTOR
            </h3>

            <p>
                Explore academic journals, books and scholarly research
                across a wide range of disciplines.
            </p>

            <a href="https://www.jstor.org/"
               target="_blank"
               rel="noopener noreferrer"
               class="research-visit-btn">

                Visit Website ↗

            </a>

        </div>

    </div>


    <!-- ================= BACK ================= -->

    <div class="research-back">

        <a asp-controller="Home"
           asp-action="EResources"
           class="research-back-btn">

            ← Back to E-Resources

        </a>

    </div>

</div>