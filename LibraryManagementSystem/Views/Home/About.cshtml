@{
    ViewData["Title"] = "About IUBAT Central Library";
}

<div class="library-page">

    <div class="library-page-header">

        <h1>About IUBAT Central Library</h1>

        <p>
            Knowledge for Innovation and Excellence.
        </p>

    </div>


    <div class="about-library">

        <h2>Our Library</h2>

        <p>
            IUBAT Central Library supports teaching, learning and research
            by providing access to books, digital resources, journals,
            thesis collections and other academic materials.
        </p>

        <p>
            Our goal is to create a welcoming learning environment where
            students, faculty and researchers can easily discover and
            access the information they need.
        </p>


        <h2 class="mt-4">
            Our Mission
        </h2>

        <p>
            To provide quality information resources and library services
            that support academic excellence, research and lifelong learning.
        </p>


        <div class="about-info">

            <div>
                <strong>Library Hours</strong>
                <p>8:00 AM - 8:30 PM</p>
            </div>

            <div>
                <strong>Email</strong>
                <p>library@iubat.edu</p>
            </div>

            <div>
                <strong>Location</strong>
                <p>IUBAT Central Library</p>
            </div>

        </div>

    </div>


    <div class="library-back">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            ← Back to Home
        </a>

    </div>

</div>