@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-container">

        <!-- Left Side -->

        <div class="login-brand">

            <div class="brand-logo">
                <img src="~/images/iubat-logo.png"
                     alt="IUBAT Logo" />
            </div>

            <h1>
                IUBAT Central Library
            </h1>

            <p class="brand-tagline">
                Knowledge for Innovation and Excellence
            </p>

            <div class="brand-message">

                <h2>
                    Welcome Back!
                </h2>

                <p>
                    Sign in to access your library account,
                    browse books and manage your resources.
                </p>

            </div>

        </div>


        <!-- Right Side -->

        <div class="login-form-section">

            <div class="login-form-container">

                <div class="login-heading">

                    <div class="login-icon">
                        🔐
                    </div>

                    <h2>
                        Sign In
                    </h2>

                    <p>
                        Login to your library account
                    </p>

                </div>


                <!-- Validation -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>


                <form id="account"
                      method="post">

                    <!-- Email -->

                    <div class="form-group mb-3">

                        <label asp-for="Input.Email"
                               class="form-label">
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                ✉
                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control login-input"
                                   autocomplete="username"
                                   placeholder="Enter your email" />

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Password -->

                    <div class="form-group mb-3">

                        <div class="d-flex justify-content-between">

                            <label asp-for="Input.Password"
                                   class="form-label">
                                Password
                            </label>

                            <a asp-page="./ForgotPassword"
                               class="forgot-link">
                                Forgot Password?
                            </a>

                        </div>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                🔒
                            </span>

                            <input asp-for="Input.Password"
                                   class="form-control login-input"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" />

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Remember Me -->

                    <div class="form-check mb-4">

                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />

                        <label class="form-check-label"
                               asp-for="Input.RememberMe">
                            Remember me
                        </label>

                    </div>


                    <!-- Login Button -->

                    <button id="login-submit"
                            type="submit"
                            class="btn login-button w-100">

                        🔐 Sign In

                    </button>

                </form>


                <!-- Register -->

                <div class="register-section">

                    <p class="mb-2">
                        Don't have a library account?
                    </p>

                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="register-link">

                        Create an Account

                    </a>

                </div>


                <!-- Back to Home -->

                <div class="auth-back-home">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="auth-back-home-btn">

                        ← Back to Home

                    </a>

                </div>


                <!-- External Login -->
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="external-login">

                        <div class="divider">
                            <span>OR</span>
                        </div>

                        <h5>
                            Sign in with
                        </h5>

                        <form id="external-account"
                              asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post">

                            <div>

                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit"
                                            class="btn btn-outline-secondary w-100 mb-2"
                                            name="provider"
                                            value="@provider.Name"
                                            title="Log in using your @provider.DisplayName account">

                                        @provider.DisplayName

                                    </button>
                                }

                            </div>

                        </form>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}